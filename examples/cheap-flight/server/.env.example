# AICP Mock Server Configuration

# Port to listen on (default: 3000)
PORT=3000

# Log level (default: info)
LOG_LEVEL=info

# Mock server delay (milliseconds, default: 0)
MOCK_DELAY=0

# Enable CORS (default: true)
CORS_ENABLED=true

# Origin for AICP contract (default: http://localhost:3000)
AICP_ORIGIN=http://localhost:3000
